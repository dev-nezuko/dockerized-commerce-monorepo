# Copy to .env and replace every empty value. Keep .env out of version control.
# Use letters and digits for the password; it is placed inside a database URL.
POSTGRES_PASSWORD=
# At least 32 random characters, e.g. the output of: openssl rand -base64 48
JWT_SECRET=
# Account created by the demo seed.
SEED_USER_EMAIL=demo@example.invalid
SEED_USER_PASSWORD=
